{#- ==========================================================================
     CIS compliance report - rendered on the Ansible control node.
     Self-contained: no external CSS, fonts, JS or images.
     ========================================================================== -#}
{%- set R = cis_result -%}
{%- set S = R.summary -%}
{%- set SA = S.all -%}
{%- set MODE = cis_mode_effective | default(R.mode) -%}
{%- set IS_APPLY = (MODE == 'apply') -%}
{%- set GUID = cis_guidance | default({}) -%}
{%- set SEC = cis_sections | default({'chapters': {}, 'subsections': {}}) -%}
{%- set ST = {
      'pass':          {'zh': '通过',     'cls': 'ok'},
      'fail':          {'zh': '未通过',   'cls': 'bad'},
      'manual':        {'zh': '人工核查', 'cls': 'man'},
      'error':         {'zh': '检查异常', 'cls': 'err'},
      'notapplicable': {'zh': '不适用',   'cls': 'na'},
      'skipped':       {'zh': '已跳过',   'cls': 'na'}
   } -%}
{%- set AP = {
      'applied':            {'zh': '已修复',      'cls': 'ok'},
      'applied_pending':    {'zh': '已改·待生效', 'cls': 'warn'},
      'already':            {'zh': '本就合规',    'cls': 'ok'},
      'failed':             {'zh': '修复失败',    'cls': 'bad'},
      'skipped_disruptive': {'zh': '跳过·高风险', 'cls': 'warn'},
      'unsupported':        {'zh': '无自动修复',  'cls': 'na'},
      'skipped_scan':       {'zh': '仅扫描',      'cls': 'na'},
      'n/a':                {'zh': '—',           'cls': 'na'}
   } -%}
{%- set RISK = {'safe': '低风险', 'disruptive': '高风险', 'none': '不涉及'} -%}
{#- overall scalars -#}
{%- set a_total  = SA.total            | default(0) | int -%}
{%- set a_pass   = SA['pass']          | default(0) | int -%}
{%- set a_fail   = SA.fail             | default(0) | int -%}
{%- set a_man    = SA.manual           | default(0) | int -%}
{%- set a_err    = SA.error            | default(0) | int -%}
{%- set a_na     = SA.notapplicable    | default(0) | int -%}
{%- set a_skip   = SA.skipped_by_selection | default(0) | int -%}
{%- set a_asses  = SA.assessed         | default(0) | int -%}
{%- set a_appl   = SA.applied          | default(0) | int -%}
{%- set a_pend   = SA.applied_pending  | default(0) | int -%}
{%- set score    = SA.score            | default(0) | float -%}
{%- set tone     = 'ok' if score >= 90 else ('warn' if score >= 70 else 'bad') -%}
{#- chapter roll-up -#}
{%- set chapters = {} -%}
{%- set chorder = [] -%}
{%- for r in R.results -%}
  {%- set ch = r.id.split('.')[0] -%}
  {%- if ch not in chapters -%}
    {%- set _ = chapters.update({ch: {'total': 0, 'pass': 0, 'fail': 0, 'manual': 0,
                                      'error': 0, 'notapplicable': 0, 'skipped': 0,
                                      'applied': 0}}) -%}
    {%- set _ = chorder.append(ch) -%}
  {%- endif -%}
  {%- set c = chapters[ch] -%}
  {%- set _ = c.update({'total': c['total'] + 1}) -%}
  {%- set _ = c.update({r.status: c.get(r.status, 0) + 1}) -%}
  {%- if r.apply_status in ['applied', 'applied_pending'] -%}
    {%- set _ = c.update({'applied': c['applied'] + 1}) -%}
  {%- endif -%}
{%- endfor -%}
{%- set circ = 439.82 -%}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ cis_benchmark_name }} {{ cis_benchmark_version }} · {{ cis_host.hostname | e }}</title>
<style>
:root{
  --bg:#f4f6fa; --card:#ffffff; --ink:#16202e; --ink2:#475569; --ink3:#7c8a9e;
  --line:#e2e8f2; --line2:#eef1f7; --brand:#1c3f7c; --brand2:#2f6fd0;
  --ok:#127a3d; --okbg:#e7f5ec; --okln:#bfe3cd;
  --bad:#b3261e; --badbg:#fdeceb; --badln:#f3c9c6;
  --warn:#9a5b00; --warnbg:#fdf3e2; --warnln:#f1dcb4;
  --man:#1e4bb8; --manbg:#e9effc; --manln:#c8d6f6;
  --err:#7c3aed; --errbg:#f2ecfe; --errln:#ddd0fb;
  --na:#64748b;  --nabg:#eef1f6;  --naln:#dde3ec;
  --shadow:0 1px 2px rgba(16,32,56,.05),0 8px 24px rgba(16,32,56,.06);
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  margin:0;background:var(--bg);color:var(--ink);
  font:14px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC",
       "Hiragino Sans GB","Microsoft YaHei",Roboto,"Helvetica Neue",Arial,sans-serif;
  font-variant-numeric:tabular-nums;
}
code{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
.wrap{max-width:1280px;margin:0 auto;padding:0 24px 64px}

/* ---------- masthead ---------- */
.mast{background:linear-gradient(135deg,#16305e 0%,#1c3f7c 45%,#2a5ba8 100%);color:#fff}
.mast-in{max-width:1280px;margin:0 auto;padding:26px 24px 32px;
  display:flex;flex-wrap:wrap;gap:18px;align-items:flex-start;justify-content:space-between}
.mast h1{margin:0;font-size:21px;font-weight:650;letter-spacing:.2px}
.mast .sub{margin-top:6px;font-size:13px;color:#c3d3ec}
.mast .org{font-size:12px;color:#9fb6d8;letter-spacing:.6px;text-transform:uppercase;
  margin-bottom:8px;font-weight:600}
.mbadges{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.mb{display:inline-flex;align-items:center;padding:5px 11px;border-radius:999px;
  font-size:12px;font-weight:600;background:rgba(255,255,255,.14);
  border:1px solid rgba(255,255,255,.22)}
.mb.hot{background:#f0b429;border-color:#f0b429;color:#3d2c00}
.mb.cool{background:rgba(255,255,255,.92);color:#16305e;border-color:transparent}

/* ---------- host identity ---------- */
.idcard{background:var(--card);border:1px solid var(--line);border-radius:14px;
  box-shadow:var(--shadow);margin-top:-18px;position:relative;overflow:hidden}
.idcard .strip{height:3px;background:linear-gradient(90deg,var(--brand2),#48b7a2,#f0b429)}
.idgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(196px,1fr));gap:1px;
  background:var(--line2)}
.idcell{background:var(--card);padding:15px 18px}
.idcell .k{font-size:11px;color:var(--ink3);letter-spacing:.7px;text-transform:uppercase;
  font-weight:700}
.idcell .v{margin-top:5px;font-size:16px;font-weight:600;color:var(--ink);
  word-break:break-all;line-height:1.35}
.idcell .v.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:15px}
.idcell.hero .v{font-size:19px;color:var(--brand)}
.idcell .sm{font-size:13.5px;font-weight:600}
.idmore{border-top:1px solid var(--line2);padding:0 18px}
.idmore summary{cursor:pointer;padding:11px 0;font-size:12.5px;color:var(--ink2);
  font-weight:600;list-style:none;display:flex;align-items:center;gap:6px}
.idmore summary::-webkit-details-marker{display:none}
.idmore summary::before{content:"\25B8";color:var(--ink3);transition:transform .15s}
.idmore[open] summary::before{transform:rotate(90deg)}
.iftab{width:100%;border-collapse:collapse;margin-bottom:14px;font-size:13px}
.iftab th{text-align:left;font-size:11px;color:var(--ink3);text-transform:uppercase;
  letter-spacing:.6px;padding:6px 10px;border-bottom:1px solid var(--line)}
.iftab td{padding:7px 10px;border-bottom:1px solid var(--line2);
  font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
.iftab tr:last-child td{border-bottom:none}

/* ---------- section headings ---------- */
h2.sec{font-size:15px;font-weight:650;margin:30px 0 13px;color:var(--ink);
  display:flex;align-items:center;gap:9px;flex-wrap:wrap}
h2.sec::before{content:"";width:3px;height:15px;background:var(--brand2);border-radius:2px}
h2.sec .hint{font-weight:400;font-size:12.5px;color:var(--ink3)}

/* ---------- score + level cards ---------- */
.deck{display:grid;grid-template-columns:296px 1fr 1fr;gap:16px;align-items:stretch}
@media (max-width:1080px){.deck{grid-template-columns:1fr}}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;
  box-shadow:var(--shadow);padding:20px}
.card h3{margin:0 0 2px;font-size:13px;font-weight:650;letter-spacing:.3px;
  display:flex;align-items:center;justify-content:space-between;gap:8px}
.card .cap{font-size:11.5px;color:var(--ink3);margin-bottom:14px;line-height:1.5}

.ring{position:relative;width:164px;height:164px;margin:2px auto 0}
.ring svg{transform:rotate(-90deg);display:block}
.ring .ctr{position:absolute;left:0;top:0;right:0;bottom:0;display:flex;
  flex-direction:column;align-items:center;justify-content:center;gap:2px}
.ring .val{font-size:34px;font-weight:700;line-height:1;letter-spacing:-1px}
.ring .lab{font-size:12px;color:var(--ink3)}
.dlegend{margin-top:16px;display:grid;gap:7px}
.dlegend div{display:flex;align-items:center;gap:8px;font-size:12.5px;color:var(--ink2)}
.dot{width:9px;height:9px;border-radius:2px;flex:0 0 9px}
.dlegend b{margin-left:auto;color:var(--ink);font-weight:650}

.lvtag{display:inline-flex;align-items:center;padding:3px 9px;border-radius:6px;
  font-size:11px;font-weight:700;letter-spacing:.4px}
.lvtag.l1{background:#e9effc;color:#1e4bb8}
.lvtag.l2{background:#f4ecfd;color:#6d28d9}

.bigrow{display:flex;align-items:baseline;gap:10px;margin:4px 0 14px;flex-wrap:wrap}
.bigrow .n{font-size:40px;font-weight:700;line-height:1;letter-spacing:-1.4px}
.bigrow .u{font-size:12.5px;color:var(--ink3)}
.bar{height:8px;border-radius:5px;background:var(--nabg);overflow:hidden;display:flex}
.bar i{display:block;height:100%}
.barlabels{display:flex;justify-content:space-between;gap:8px;font-size:11.5px;
  color:var(--ink3);margin-top:6px;flex-wrap:wrap}
.kv{display:grid;grid-template-columns:1fr auto;margin-top:15px;
  border-top:1px solid var(--line2)}
.kv .k,.kv .v{padding:7px 0;border-bottom:1px solid var(--line2);font-size:12.5px}
.kv .k{color:var(--ink2);display:flex;align-items:center;gap:7px}
.kv .v{text-align:right;font-weight:650;color:var(--ink);padding-left:12px}
.kv .v.z{color:var(--ink3);font-weight:500}
.pill{display:inline-flex;align-items:center;padding:1px 7px;border-radius:5px;
  font-size:11px;font-weight:600;border:1px solid transparent;white-space:nowrap}
.pill.ok{background:var(--okbg);color:var(--ok);border-color:var(--okln)}
.pill.bad{background:var(--badbg);color:var(--bad);border-color:var(--badln)}
.pill.warn{background:var(--warnbg);color:var(--warn);border-color:var(--warnln)}
.pill.man{background:var(--manbg);color:var(--man);border-color:var(--manln)}
.pill.err{background:var(--errbg);color:var(--err);border-color:var(--errln)}
.pill.na{background:var(--nabg);color:var(--na);border-color:var(--naln)}

.notice{margin-top:14px;padding:9px 12px;border-radius:9px;font-size:12.5px;
  background:var(--manbg);color:#1b3f96;border:1px solid var(--manln);line-height:1.6}
.notice.warn{background:var(--warnbg);color:var(--warn);border-color:var(--warnln)}
.notice code{background:rgba(0,0,0,.06);padding:1px 5px;border-radius:4px;font-size:11.5px}

/* ---------- chapter breakdown ---------- */
.chaps{background:var(--card);border:1px solid var(--line);border-radius:14px;
  box-shadow:var(--shadow);padding:8px 20px 14px}
.chap{display:grid;grid-template-columns:238px 1fr 132px;gap:14px;align-items:center;
  padding:11px 0;border-bottom:1px solid var(--line2)}
.chap:last-child{border-bottom:none}
@media (max-width:760px){.chap{grid-template-columns:1fr}}
.chap .nm{font-size:13px;font-weight:600;overflow:hidden;text-overflow:ellipsis;
  white-space:nowrap}
.chap .nm span{color:var(--ink3);font-weight:500}
.chap .cnt{font-size:12px;color:var(--ink2);text-align:right}
.sbar{height:11px;border-radius:6px;overflow:hidden;display:flex;background:var(--nabg)}
.sbar i{height:100%}

/* ---------- toolbar ---------- */
.toolbar{background:var(--card);border:1px solid var(--line);border-radius:12px;
  padding:11px 14px;display:flex;gap:9px;flex-wrap:wrap;align-items:center;
  box-shadow:var(--shadow);position:sticky;top:0;z-index:20}
.chip{border:1px solid var(--line);background:#fff;border-radius:999px;padding:5px 12px;
  font-size:12.5px;cursor:pointer;color:var(--ink2);font-weight:600;
  display:inline-flex;align-items:center;gap:6px;user-select:none}
.chip:hover{border-color:#c4cee0}
.chip.on{background:var(--brand);border-color:var(--brand);color:#fff}
.chip .c{font-size:11px;opacity:.75}
.toolbar input[type=search],.toolbar select{
  border:1px solid var(--line);border-radius:8px;padding:6px 10px;font-size:13px;
  background:#fff;color:var(--ink);font-family:inherit}
.toolbar input[type=search]{flex:1;min-width:190px}
.tbtn{border:1px solid var(--line);background:#fff;border-radius:8px;padding:6px 11px;
  font-size:12.5px;cursor:pointer;color:var(--ink2);font-weight:600}
.tbtn:hover{border-color:#c4cee0}

/* ---------- findings table ---------- */
.tblwrap{background:var(--card);border:1px solid var(--line);border-radius:12px;
  box-shadow:var(--shadow);overflow:hidden;margin-top:12px}
table.f{width:100%;border-collapse:collapse}
table.f thead th{position:sticky;top:52px;background:#f8fafd;z-index:10;
  text-align:left;font-size:11px;letter-spacing:.6px;text-transform:uppercase;
  color:var(--ink3);font-weight:700;padding:10px 12px;border-bottom:1px solid var(--line)}
table.f tbody tr.r{border-bottom:1px solid var(--line2);cursor:pointer}
table.f tbody tr.r:hover{background:#f8fbff}
table.f tbody tr.r.open{background:#f4f8ff}
table.f td{padding:10px 12px;vertical-align:top}
td.id{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  font-size:12.5px;font-weight:600;color:var(--brand);white-space:nowrap}
td.ti{font-size:13px;line-height:1.5}
td.ti .fam{display:block;margin-top:3px;font-size:11px;color:var(--ink3)}
td.c{white-space:nowrap}
tr.d{display:none;background:#fbfcfe}
tr.d.show{display:table-row}
tr.d td{padding:0 12px 16px}
.det{border-left:3px solid var(--brand2);padding:2px 0 2px 14px}
.det h4{margin:13px 0 5px;font-size:11.5px;letter-spacing:.6px;text-transform:uppercase;
  color:var(--ink3);font-weight:700}
.det h4:first-child{margin-top:2px}
.det p{margin:0;font-size:13px;color:var(--ink2);line-height:1.65}
.det pre{margin:0;padding:10px 12px;background:#0f172a;color:#dbe6f5;border-radius:8px;
  font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;
  line-height:1.6;overflow-x:auto;white-space:pre-wrap;word-break:break-word}
.det .obs{background:var(--nabg);color:var(--ink);border-radius:8px;padding:9px 12px;
  font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;
  white-space:pre-wrap;word-break:break-word;line-height:1.6}
.det .obs.bad{background:var(--badbg);color:#7f1d1d}
.det .obs.ok{background:var(--okbg);color:#14532d}
.det .obs.warn{background:var(--warnbg);color:#78350f}
.empty{padding:40px;text-align:center;color:var(--ink3);font-size:13.5px;display:none}

/* ---------- collapsibles ---------- */
details.blk{background:var(--card);border:1px solid var(--line);border-radius:12px;
  box-shadow:var(--shadow);margin-top:12px;overflow:hidden}
details.blk>summary{cursor:pointer;padding:13px 18px;font-size:13px;font-weight:650;
  list-style:none;display:flex;align-items:center;gap:8px}
details.blk>summary::-webkit-details-marker{display:none}
details.blk>summary::before{content:"\25B8";color:var(--ink3);transition:transform .15s}
details.blk[open]>summary::before{transform:rotate(90deg)}
details.blk>summary .n{margin-left:auto;color:var(--ink3);font-weight:600;font-size:12px}
.blkbody{padding:0 18px 16px;font-size:13px;color:var(--ink2)}
.blkbody ul{margin:0;padding-left:18px;line-height:1.85}
.blkbody code{font-size:12px;background:var(--nabg);padding:1px 5px;border-radius:4px}
.exl{width:100%;border-collapse:collapse;font-size:12.5px}
.exl td{padding:6px 8px;border-bottom:1px solid var(--line2);vertical-align:top}
.exl tr:last-child td{border-bottom:none}
.exl td:first-child{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  white-space:nowrap;color:var(--brand);font-weight:600;width:1%}
.exl td:last-child{color:var(--ink3);white-space:nowrap;width:1%;text-align:right}

footer{margin-top:34px;padding-top:16px;border-top:1px solid var(--line);
  font-size:11.5px;color:var(--ink3);line-height:1.95}
footer b{color:var(--ink2)}

@media print{
  body{background:#fff}
  .toolbar{display:none}
  .mast{background:#16305e !important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .card,.chaps,.tblwrap,.idcard,details.blk{box-shadow:none;break-inside:avoid}
  table.f thead th{position:static}
}
</style>
</head>
<body>

<header class="mast">
  <div class="mast-in">
    <div>
      {% if cis_org_name %}<div class="org">{{ cis_org_name | e }}</div>{% endif %}
      <h1>{{ cis_benchmark_name }} {{ cis_benchmark_version }} 合规报告</h1>
      <div class="sub">
        {{ cis_host.hostname | e }}
        {%- if cis_host.fqdn and cis_host.fqdn != cis_host.hostname %} · {{ cis_host.fqdn | e }}{% endif %}
        &nbsp;|&nbsp; 生成于 {{ cis_run_human }} &nbsp;|&nbsp; 采集耗时 {{ R.duration_seconds }}s
      </div>
    </div>
    <div class="mbadges">
      <span class="mb {{ 'hot' if IS_APPLY else 'cool' }}">{{ '修复模式 APPLY' if IS_APPLY else '扫描模式 SCAN' }}</span>
      <span class="mb cool">配置档 {{ cis_profile }}</span>
      <span class="mb">平台 {{ cis_platform }}</span>
      {% if IS_APPLY %}<span class="mb">高风险修复 {{ '已放行' if cis_allow_disruptive | bool else '已拦截' }}</span>{% endif %}
      <span class="mb">引擎 v{{ R.engine_version }}</span>
    </div>
  </div>
</header>

<div class="wrap">

  <!-- ============ host identity ============ -->
  <section class="idcard">
    <div class="strip"></div>
    <div class="idgrid">
      <div class="idcell hero">
        <div class="k">主机名 Hostname</div>
        <div class="v">{{ cis_host.hostname | e }}</div>
      </div>
      <div class="idcell hero">
        <div class="k">IP 地址 IPv4</div>
        <div class="v mono">{{ cis_host.ipv4 | e if cis_host.ipv4 else '—' }}</div>
      </div>
      <div class="idcell hero">
        <div class="k">MAC 地址</div>
        <div class="v mono">{{ cis_host.mac | upper | e if cis_host.mac else '—' }}</div>
      </div>
      <div class="idcell">
        <div class="k">操作系统</div>
        <div class="v sm">{{ cis_host.os | e if cis_host.os else '—' }}</div>
      </div>
      <div class="idcell">
        <div class="k">内核 / 架构</div>
        <div class="v mono" style="font-size:13px">{{ cis_host.kernel | e }}{% if cis_host.arch %} · {{ cis_host.arch | e }}{% endif %}</div>
      </div>
      <div class="idcell">
        <div class="k">运行环境</div>
        <div class="v sm">{{ cis_host.virtualization | e if cis_host.virtualization else '—' }}{% if cis_host.uptime_seconds | int > 0 %}<span style="color:var(--ink3);font-weight:500"> · 已运行 {{ cis_host.uptime_seconds | int // 86400 }} 天</span>{% endif %}</div>
      </div>
    </div>
    <details class="idmore">
      <summary>网络接口明细（{{ cis_host.interfaces | length }} 个接口 · {{ cis_host.all_ipv4 | length }} 个 IPv4 地址） · Ansible 连接地址 {{ cis_host.ssh_address | e }}</summary>
      <table class="iftab">
        <thead><tr><th>接口</th><th>MAC</th><th>IPv4</th><th>IPv6</th></tr></thead>
        <tbody>
        {% for dev, d in (cis_host.interfaces | dictsort) %}
          <tr>
            <td>{{ dev | e }}</td>
            <td>{{ (d.mac | upper) if d.mac else '—' }}</td>
            <td>{{ d.ipv4 | join(', ') if d.ipv4 else '—' }}</td>
            <td>{{ d.ipv6 | join(', ') if d.ipv6 else '—' }}</td>
          </tr>
        {% else %}
          <tr><td colspan="4">未采集到接口明细（目标机上缺少 <code>ip</code> 命令）</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </details>
  </section>

  <!-- ============ score + L1/L2 ============ -->
  <h2 class="sec">合规概览
    <span class="hint">本次评估 {{ a_total }} 条规则，其中 {{ a_asses }} 条可自动判定{% if a_skip %}；另有 {{ a_skip }} 条因配置档 / 平台筛选未纳入{% endif %}</span>
  </h2>

  <div class="deck">
    <!-- overall score -->
    <div class="card">
      <h3>整体合规分
        <span class="pill {{ tone }}">{{ '优秀' if tone == 'ok' else ('待改进' if tone == 'warn' else '风险偏高') }}</span>
      </h3>
      <div class="cap">通过项 ÷（通过 + 未通过）</div>
      <div class="ring">
        <svg width="164" height="164" viewBox="0 0 164 164">
          <circle cx="82" cy="82" r="70" fill="none" stroke="#eef1f7" stroke-width="17"></circle>
          <circle cx="82" cy="82" r="70" fill="none" stroke-linecap="round" stroke-width="17"
                  stroke="{{ '#127a3d' if tone == 'ok' else ('#c98a12' if tone == 'warn' else '#b3261e') }}"
                  stroke-dasharray="{{ (score / 100 * circ) | round(1) }} {{ circ }}"></circle>
        </svg>
        <div class="ctr">
          <div class="val" style="color:{{ '#127a3d' if tone == 'ok' else ('#9a5b00' if tone == 'warn' else '#b3261e') }}">{{ score }}<span style="font-size:17px">%</span></div>
          <div class="lab">{{ a_pass }} / {{ a_asses }}</div>
        </div>
      </div>
      <div class="dlegend">
        <div><span class="dot" style="background:#127a3d"></span>通过<b>{{ a_pass }}</b></div>
        <div><span class="dot" style="background:#b3261e"></span>未通过<b>{{ a_fail }}</b></div>
        <div><span class="dot" style="background:#1e4bb8"></span>人工核查<b>{{ a_man }}</b></div>
        <div><span class="dot" style="background:#7c3aed"></span>检查异常<b>{{ a_err }}</b></div>
        <div><span class="dot" style="background:#cbd5e1"></span>不适用<b>{{ a_na }}</b></div>
      </div>
    </div>

    {% for lv in ['L1', 'L2'] %}
    {%- set D = S[lv] -%}
    {%- set tot = D.total | default(0) | int -%}
    {%- set npass = D['pass'] | default(0) | int -%}
    {%- set nfail = D.fail | default(0) | int -%}
    {%- set nman = D.manual | default(0) | int -%}
    {%- set nerr = D.error | default(0) | int -%}
    {%- set applied = D.applied | default(0) | int -%}
    {%- set pending = D.applied_pending | default(0) | int -%}
    {%- set afail = D.apply_failed | default(0) | int -%}
    {%- set adisr = D.skipped_disruptive | default(0) | int -%}
    {%- set auns = D.unsupported | default(0) | int -%}
    {%- set alrd = D.already | default(0) | int -%}
    {%- set tt = [tot, 1] | max -%}
    <div class="card">
      <h3>
        <span><span class="lvtag {{ lv | lower }}">{{ lv }}</span>
          &nbsp;{{ 'Level 1 · 基线防护' if lv == 'L1' else 'Level 2 · 纵深防御' }}</span>
        <span class="pill na">本次 {{ tot }} 条</span>
      </h3>
      <div class="cap">
        {% if IS_APPLY %}本次 apply 实际修复的 {{ lv }} 规则条数{% else %}scan 模式不做任何变更，以下为待修复项{% endif %}
      </div>

      {% if IS_APPLY %}
      <div class="bigrow">
        <span class="n" style="color:{{ '#127a3d' if applied > 0 else '#7c8a9e' }}">{{ applied }}</span>
        <span class="u">条已修复{% if pending %}，另 {{ pending }} 条已改待生效{% endif %}</span>
      </div>
      {% else %}
      <div class="bigrow">
        <span class="n" style="color:{{ '#b3261e' if nfail > 0 else '#127a3d' }}">{{ nfail }}</span>
        <span class="u">条待修复 / 共 {{ tot }} 条</span>
      </div>
      {% endif %}

      <div class="bar">
        <i style="background:#127a3d;width:{{ (100.0 * npass / tt) | round(2) }}%"></i>
        <i style="background:#b3261e;width:{{ (100.0 * nfail / tt) | round(2) }}%"></i>
        <i style="background:#1e4bb8;width:{{ (100.0 * nman / tt) | round(2) }}%"></i>
        <i style="background:#7c3aed;width:{{ (100.0 * nerr / tt) | round(2) }}%"></i>
      </div>
      <div class="barlabels">
        <span>合规率 <b style="color:var(--ink)">{{ D.score }}%</b></span>
        <span>{{ npass }} 通过 · {{ nfail }} 未通过 · {{ nman }} 人工</span>
      </div>

      <div class="kv">
        <div class="k"><span class="pill ok">已修复</span>applied</div>
        <div class="v{{ ' z' if applied == 0 }}">{{ applied }}</div>
        <div class="k"><span class="pill warn">已改·待生效</span>需重启 / 重载</div>
        <div class="v{{ ' z' if pending == 0 }}">{{ pending }}</div>
        <div class="k"><span class="pill bad">修复失败</span>apply_failed</div>
        <div class="v{{ ' z' if afail == 0 }}">{{ afail }}</div>
        <div class="k"><span class="pill warn">跳过·高风险</span>需显式放行</div>
        <div class="v{{ ' z' if adisr == 0 }}">{{ adisr }}</div>
        <div class="k"><span class="pill na">无自动修复</span>需人工处置</div>
        <div class="v{{ ' z' if auns == 0 }}">{{ auns }}</div>
        <div class="k"><span class="pill ok">本就合规</span>无需变更</div>
        <div class="v{{ ' z' if alrd == 0 }}">{{ alrd }}</div>
      </div>

      {% if not IS_APPLY %}
      <div class="notice">
        执行 <code>-e cis_mode=apply -e cis_profile={{ lv }}</code> 可自动修复其中风险可控的部分；
        涉及重启或服务中断的规则默认跳过。
      </div>
      {% elif adisr > 0 and not cis_allow_disruptive | bool %}
      <div class="notice warn">
        {{ adisr }} 条修复涉及重启、分区挂载或服务中断，已按默认策略跳过。
        确认变更窗口后追加 <code>-e cis_allow_disruptive=true</code> 重跑。
      </div>
      {% endif %}
    </div>
    {% endfor %}
  </div>

  <!-- ============ chapters ============ -->
  <h2 class="sec">章节分布<span class="hint">绿=通过　红=未通过　蓝=人工核查　紫=检查异常</span></h2>
  <div class="chaps">
    {% for ch in chorder | sort %}
    {%- set c = chapters[ch] -%}
    {%- set t = [c['total'], 1] | max -%}
    <div class="chap">
      <div class="nm">{{ ch }}. {{ SEC.chapters.get(ch, '') | e }} <span>({{ c['total'] }})</span></div>
      <div class="sbar">
        <i style="background:#127a3d;width:{{ (100.0 * c['pass'] / t) | round(2) }}%"></i>
        <i style="background:#b3261e;width:{{ (100.0 * c['fail'] / t) | round(2) }}%"></i>
        <i style="background:#1e4bb8;width:{{ (100.0 * c['manual'] / t) | round(2) }}%"></i>
        <i style="background:#7c3aed;width:{{ (100.0 * c['error'] / t) | round(2) }}%"></i>
      </div>
      <div class="cnt">
        <span style="color:#127a3d;font-weight:650">{{ c['pass'] }}</span> /
        <span style="color:#b3261e;font-weight:650">{{ c['fail'] }}</span>
        {%- if IS_APPLY and c['applied'] %} <span class="pill ok">修 {{ c['applied'] }}</span>{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>

  <!-- ============ findings ============ -->
  <h2 class="sec">检查明细<span class="hint">点击任意行展开判定依据与整改方法</span></h2>

  <div class="toolbar" id="tb">
    <span class="chip on" data-st="all">全部 <span class="c">{{ a_total }}</span></span>
    <span class="chip" data-st="fail">未通过 <span class="c">{{ a_fail }}</span></span>
    <span class="chip" data-st="pass">通过 <span class="c">{{ a_pass }}</span></span>
    <span class="chip" data-st="manual">人工核查 <span class="c">{{ a_man }}</span></span>
    {% if a_err %}<span class="chip" data-st="error">异常 <span class="c">{{ a_err }}</span></span>{% endif %}
    {% if IS_APPLY %}<span class="chip" data-st="applied">本次已修复 <span class="c">{{ a_appl + a_pend }}</span></span>{% endif %}
    <select id="flv">
      <option value="">全部级别</option>
      <option value="1">仅 Level 1</option>
      <option value="2">仅 Level 2</option>
    </select>
    <select id="fch">
      <option value="">全部章节</option>
      {% for ch in chorder | sort %}
      <option value="{{ ch }}">{{ ch }}. {{ SEC.chapters.get(ch, '') | e }}</option>
      {% endfor %}
    </select>
    <input type="search" id="fq" placeholder="搜索规则编号、标题或关键字…">
    <button class="tbtn" id="bex">展开全部</button>
    <button class="tbtn" id="bpr">打印 / 导出 PDF</button>
  </div>

  <div class="tblwrap">
    <table class="f">
      <thead>
        <tr>
          <th style="width:88px">编号</th>
          <th>规则</th>
          <th style="width:54px">级别</th>
          <th style="width:98px">结果</th>
          <th style="width:114px">{{ '修复动作' if IS_APPLY else '修复风险' }}</th>
        </tr>
      </thead>
      <tbody id="tb-body">
      {% for r in R.results %}
      {%- set g = GUID.get(r.id, {}) -%}
      {%- set sinfo = ST.get(r.status, ST['notapplicable']) -%}
      {%- set ainfo = AP.get(r.apply_status, AP['n/a']) -%}
      {%- set did = 'd' ~ (r.id | replace('.', '_')) -%}
        <tr class="r" data-id="{{ did }}" data-st="{{ r.status }}"
            data-ap="{{ 'applied' if r.apply_status in ['applied', 'applied_pending'] else '' }}"
            data-lv="{{ r.level }}" data-ch="{{ r.id.split('.')[0] }}"
            data-q="{{ (r.id ~ ' ' ~ r.title ~ ' ' ~ r.family ~ ' ' ~ SEC.subsections.get(r.section, '')) | lower | e }}">
          <td class="id">{{ r.id }}</td>
          <td class="ti">{{ r.title | e }}
            <span class="fam">{{ SEC.subsections.get(r.section, SEC.chapters.get(r.id.split('.')[0], '')) | e }}
              · {{ r.assessment }} · {{ r.family }}</span>
          </td>
          <td class="c"><span class="lvtag l{{ r.level }}">L{{ r.level }}</span></td>
          <td class="c"><span class="pill {{ sinfo.cls }}">{{ sinfo.zh }}</span></td>
          <td class="c">
            {%- if IS_APPLY -%}
            <span class="pill {{ ainfo.cls }}">{{ ainfo.zh }}</span>
            {%- else -%}
            <span class="pill {{ 'warn' if r.risk == 'disruptive' else ('na' if r.risk == 'none' else 'ok') }}">{{ RISK.get(r.risk, r.risk) }}</span>
            {%- endif -%}
          </td>
        </tr>
        <tr class="d" id="{{ did }}">
          <td colspan="5">
            <div class="det">
              <h4>检查结论</h4>
              <div class="obs {{ sinfo.cls if sinfo.cls in ['bad', 'ok', 'warn'] else '' }}">{{ (r.detail or '（无输出）') | e }}</div>
              {% if r.apply_status not in ['n/a', 'already'] %}
              <h4>修复动作 · {{ ainfo.zh }}</h4>
              <div class="obs {{ ainfo.cls if ainfo.cls in ['bad', 'ok', 'warn'] else '' }}">{{ (r.apply_detail or '—') | e }}</div>
              {% endif %}
              {% if g.get('description') %}<h4>规则说明</h4><p>{{ g.get('description') | e }}</p>{% endif %}
              {% if g.get('rationale') %}<h4>安全依据</h4><p>{{ g.get('rationale') | e }}</p>{% endif %}
              {% if g.get('impact') %}<h4>业务影响</h4><p>{{ g.get('impact') | e }}</p>{% endif %}
              {% if g.get('audit') %}<h4>人工核查步骤（CIS 原文）</h4><pre>{{ g.get('audit') | e }}</pre>{% endif %}
              {% if cis_report_embed_remediation | bool and g.get('remediation') and r.status in ['fail', 'error', 'manual'] %}
              <h4>整改方法（CIS 原文）</h4><pre>{{ g.get('remediation') | e }}</pre>
              {% endif %}
              <h4>元信息</h4>
              <p>适用级别 L{{ r.levels | join('/L') }} · 判定方式 {{ r.assessment }}
                 · 实现族 <code>{{ r.family }}</code>
                 · 修复风险 {{ RISK.get(r.risk, r.risk) }}
                 {%- if r.page %} · 基准 PDF 第 {{ r.page }} 页{% endif %}
                 · 耗时 {{ r.duration_ms }} ms</p>
            </div>
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    <div class="empty" id="none">没有匹配的规则，试试放宽筛选条件。</div>
  </div>

  {% if IS_APPLY and R.changed_files %}
  <details class="blk" open>
    <summary>本次改动的文件<span class="n">{{ R.changed_files | length }} 个</span></summary>
    <div class="blkbody">
      <p style="margin:0 0 8px">原文件已备份至 <code>{{ cis_backup_dir }}</code>，可按需回滚。</p>
      <ul>{% for f in R.changed_files %}<li><code>{{ f | e }}</code></li>{% endfor %}</ul>
    </div>
  </details>
  {% endif %}

  {% if R.excluded %}
  <details class="blk">
    <summary>未纳入本次评估的规则<span class="n">{{ R.excluded | length }} 条</span></summary>
    <div class="blkbody">
      <table class="exl">
        {% for x in R.excluded %}
        <tr><td>{{ x.id }}</td><td>{{ x.title | e }}</td><td>{{ x.reason | e }}</td></tr>
        {% endfor %}
      </table>
    </div>
  </details>
  {% endif %}

  {% if R.engine_notes %}
  <details class="blk">
    <summary>引擎运行提示<span class="n">{{ R.engine_notes | length }} 条</span></summary>
    <div class="blkbody"><ul>{% for n in R.engine_notes %}<li>{{ n | e }}</li>{% endfor %}</ul></div>
  </details>
  {% endif %}

  <footer>
    <b>{{ cis_benchmark_name }} {{ cis_benchmark_version }}</b> ·
    目标 <b>{{ cis_host.hostname | e }}</b>（{{ cis_host.ipv4 | e }} / {{ cis_host.mac | upper | e }}） ·
    模式 <b>{{ '修复 apply' if IS_APPLY else '扫描 scan' }}</b> ·
    配置档 <b>{{ cis_profile }}</b> · 平台 <b>{{ cis_platform }}</b><br>
    评估开始 {{ R.started_at }} · 目标机耗时 {{ R.duration_seconds }} 秒 ·
    引擎 v{{ R.engine_version }} · 报告生成 {{ cis_run_human }}（控制节点时间）<br>
    合规分 = 通过 ÷（通过 + 未通过）；标记为「人工核查 / 不适用」的规则不计入分母。
    本报告为自动化评估结果，不能替代人工安全审计。
  </footer>
</div>

<script>
(function () {
  var body = document.getElementById('tb-body');
  var rows = [].slice.call(body.querySelectorAll('tr.r'));
  var chips = [].slice.call(document.querySelectorAll('#tb .chip'));
  var q = document.getElementById('fq');
  var lv = document.getElementById('flv');
  var ch = document.getElementById('fch');
  var none = document.getElementById('none');
  var state = 'all';

  function apply() {
    var text = q.value.trim().toLowerCase();
    var wantLv = lv.value, wantCh = ch.value, shown = 0;
    rows.forEach(function (tr) {
      var ok = true;
      if (state === 'applied') { ok = tr.dataset.ap === 'applied'; }
      else if (state !== 'all') { ok = tr.dataset.st === state; }
      if (ok && wantLv) { ok = tr.dataset.lv === wantLv; }
      if (ok && wantCh) { ok = tr.dataset.ch === wantCh; }
      if (ok && text) { ok = tr.dataset.q.indexOf(text) !== -1; }
      tr.style.display = ok ? '' : 'none';
      var d = document.getElementById(tr.dataset.id);
      if (d && !ok) { d.classList.remove('show'); tr.classList.remove('open'); }
      if (ok) { shown++; }
    });
    none.style.display = shown ? 'none' : 'block';
  }

  chips.forEach(function (c) {
    c.addEventListener('click', function () {
      chips.forEach(function (x) { x.classList.remove('on'); });
      c.classList.add('on');
      state = c.dataset.st;
      apply();
    });
  });
  q.addEventListener('input', apply);
  lv.addEventListener('change', apply);
  ch.addEventListener('change', apply);

  rows.forEach(function (tr) {
    tr.addEventListener('click', function () {
      var d = document.getElementById(tr.dataset.id);
      if (!d) { return; }
      tr.classList.toggle('open', d.classList.toggle('show'));
    });
  });

  var bex = document.getElementById('bex'), expanded = false;
  bex.addEventListener('click', function () {
    expanded = !expanded;
    rows.forEach(function (tr) {
      if (tr.style.display === 'none') { return; }
      var d = document.getElementById(tr.dataset.id);
      if (!d) { return; }
      d.classList.toggle('show', expanded);
      tr.classList.toggle('open', expanded);
    });
    bex.textContent = expanded ? '收起全部' : '展开全部';
  });

  document.getElementById('bpr').addEventListener('click', function () { window.print(); });
})();
</script>
</body>
</html>
