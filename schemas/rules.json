{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CIS rule catalog",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "section", "levels", "platforms", "assessment", "family", "params", "risk", "page"],
    "properties": {
      "id": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
      "title": { "type": "string", "minLength": 1 },
      "section": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
      "levels": { "type": "array", "items": { "type": "integer", "enum": [1, 2] }, "minItems": 1 },
      "platforms": { "type": "array", "items": { "type": "string" } },
      "assessment": { "type": "string", "enum": ["Automated", "Manual"] },
      "family": { "type": "string", "minLength": 1 },
      "params": { "type": "object" },
      "risk": { "type": "string", "enum": ["safe", "disruptive", "none", "manual", "info_only", "partition", "root_access", "sshd_access", "bootloader_password", "medium", "low"] },
      "page": { "type": "integer", "minimum": 0 },
      "kind": { "type": "string" },
      "reboot_required": { "type": "boolean" }
    },
    "additionalProperties": false
  }
}
