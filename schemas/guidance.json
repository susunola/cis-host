{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CIS remediation guidance",
  "oneOf": [
    {
      "type": "object",
      "patternProperties": {
        "^[0-9]+(\\.[0-9]+)*$": {
          "type": "object",
          "properties": {
            "description": { "type": "string" },
            "rationale": { "type": "string" },
            "audit": { "type": "string" },
            "remediation": { "type": "string" },
            "impact": { "type": "string" },
            "references": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "rationale": { "type": "string" },
          "audit": { "type": "string" },
          "remediation": { "type": "string" },
          "impact": { "type": "string" },
          "references": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  ]
}
